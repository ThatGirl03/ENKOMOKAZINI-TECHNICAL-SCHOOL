{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_CLOUDINARY_CLOUD_NAME": "dn2inh6kt",
    "VITE_CLOUDINARY_UPLOAD_PRESET": "enkomokazini-signed-upload"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
